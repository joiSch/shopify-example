
<div class="trust-badges color-{{ section.settings.color_scheme }} section-{{ section.id }}">
  <div class="page-width trust-badges__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'badge' -%}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          <div class="trust-badges__icon">
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 60
                | image_tag: loading: 'lazy', alt: block.settings.title, class: 'trust-badges__icon-img'
              }}
            {%- else -%}
              <svg class="trust-badges__icon-svg" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="24" cy="21" r="15" stroke="currentColor" stroke-width="2.2"/>
                <path d="M17 21l5.5 5.5 8.5-10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 34.5L13 50l11-4.5L35 50l-5-15.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </div>
          <div class="trust-badges__text">
            {%- if block.settings.title != blank -%}
              <p class="trust-badges__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="trust-badges__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .trust-badges {
    padding-block: 32px;
  }

  .trust-badges__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 56px;
    flex-wrap: wrap;
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust-badges__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
  }

  .trust-badges__icon-svg {
    width: 44px;
    height: 44px;
  }

  .trust-badges__icon-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .trust-badges__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-badges__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground-heading);
    line-height: 1.3;
  }

  .trust-badges__subtitle {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .trust-badges__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding-inline: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Qualität"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Dank weichem Silikon"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
